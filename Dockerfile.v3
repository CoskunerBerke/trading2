# Trading Bot v3 — 7/24 AI trader (PAPER). Küçük, kök olmayan, sinyal-uyumlu imaj.
#   docker build -f Dockerfile.v3 -t tradingbot:v3 .
#   docker compose -f deploy/docker-compose.yml up -d
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Europe/Istanbul \
    TRADINGBOT_DATA=/data \
    TRADINGBOT_VAULT_PATH=/data/vault \
    MPLCONFIGDIR=/tmp/matplotlib

# git: kasa git senkronu (isteğe bağlı). PID 1 sinyal iletimi için compose `init: true` / `docker run --init` kullanın.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 10001 tradingbot \
 && useradd -u 10001 -g 10001 -m -d /home/tradingbot -s /usr/sbin/nologin tradingbot \
 && mkdir -p /data/state /data/market /data/vault /data/backups /data/logs /app \
 && chown -R 10001:10001 /data /app

WORKDIR /app

# Bağımlılıklar önce (katman önbelleği). requirements.txt'nin matplotlib websocket-client fastapi uvicorn plotly pyarrow requests
# içerdiği varsayılır; içermiyorsa aşağıdaki ek liste güvence olarak kurulur.
COPY --chown=10001:10001 requirements.txt ./
RUN pip install -r requirements.txt \
 && pip install "matplotlib>=3.8" "websocket-client>=1.6" "fastapi>=0.110" "uvicorn>=0.27" "plotly>=5.18" "pyarrow>=15" "requests>=2.31" "httpx>=0.27"

COPY --chown=10001:10001 . .

USER 10001:10001
VOLUME ["/data"]
EXPOSE 8080

# Panel /health/live yerine doctor --quick: worker konteynerinde HTTP yok
HEALTHCHECK --interval=60s --timeout=20s --start-period=90s --retries=3 \
  CMD python -m tradingbot doctor --quick || exit 1

# exec biçimi (sh -c yok) → SIGTERM doğrudan python sürecine ulaşır (graceful stop, state yazılır)
ENTRYPOINT ["python", "-m", "tradingbot"]
CMD ["watch", "--interval", "15", "--scan-every", "2"]
