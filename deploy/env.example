# Trading Bot v3 — ortam dosyası ŞABLONU. Kopyala: /opt/tradingbot/env (chmod 600) veya deploy/.env (compose).
# !!! GERÇEK DEĞERLERİ ASLA REPO'YA COMMIT ETMEYİN. Bu dosyada yalnızca boş/örnek değerler bulunur. !!!

# --- LLM (isteğe bağlı; boşsa LLM katmanı kapalı, bot deterministik çalışır)
ANTHROPIC_API_KEY=
LLM_DAILY_BUDGET_USD=2.00

# --- Binance TESTNET (isteğe bağlı; yalnızca TESTNET modunda kullanılır — testnet anahtarları, gerçek hesap DEĞİL)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_SPOT_API_KEY=
BINANCE_TESTNET_SPOT_API_SECRET=

# --- Yollar (konteynerde /data; VPS'te /opt/tradingbot/data)
TRADINGBOT_DATA=/opt/tradingbot/data
TRADINGBOT_STATE_DIR=/opt/tradingbot/data/state
TRADINGBOT_CACHE_DIR=/opt/tradingbot/data/market
TRADINGBOT_VAULT_PATH=/opt/tradingbot/data/vault
TRADINGBOT_LOG_DIR=/opt/tradingbot/data/logs
TRADINGBOT_BACKUPS_DIR=/opt/tradingbot/data/backups
TRADINGBOT_VAULT_GIT_SYNC=false

# --- Panel (salt-okunur). Loopback dışına açılacaksa token ZORUNLU; TLS için reverse proxy kullanın.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_TOKEN=

# --- Bildirim (isteğe bağlı)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- GÜVENLİK KİLİDİ
# Gerçek emir yolu VARSAYILAN OLARAK KAPALIDIR. Bu değeri "true" yapmak tek başına yeterli değildir; mod geçiş
# kapıları (paper günleri, kapanan işlem sayısı, rejim çeşitliliği) ve manuel onay da gerekir.
# UYARI: Gerçek para ile işlem kalıcı kayıp riski taşır. Bu satırı anlamadan değiştirmeyin.
ALLOW_LIVE_TRADING=false
